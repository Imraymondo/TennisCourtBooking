# Never commit a populated .env.local. Use a long unique password in deployment.
ADMIN_PASSWORD=
# One persistent, writable SQLite file; default: .data/bookings.sqlite.
BOOKING_DB_PATH=

# Public HTTPS origin. Production startup uses RENDER_EXTERNAL_URL automatically on Render.
APP_BASE_URL=
# Twilio: signing token must be available to the application, not a proxy placeholder.
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Local phone testing only: obtain from your own ngrok account; keep on your computer.
NGROK_AUTHTOKEN=
# Optional fixed development hostname from ngrok (hostname only), otherwise auto-assign.
NGROK_DOMAIN=
# Local website port used by npm run phone:local.
PHONE_WEB_PORT=3000
# Optional local troubleshooting: logs only input/turn presence, never speech or secrets.
VOICE_DEBUG=0
# Phone: gather (Twilio speech recognition/playback) or realtime (OpenAI live audio).
VOICE_MODE=gather
# Realtime uses OPENAI_API_KEY even when BOOKING_AI_ENABLED=0.
OPENAI_REALTIME_MODEL=gpt-realtime-1.5
OPENAI_REALTIME_VOICE=marin
# Input transcription supports the server-controlled booking steps; language is zh.
OPENAI_REALTIME_TRANSCRIBE_MODEL=gpt-transcribe
# REALTIME_BRIDGE_SECRET is generated by phone:local; do not set or share it.
# Optional Responses API text understanding for Gather phone + SMS; independent of Realtime.
BOOKING_AI_ENABLED=0
# Server-only project API key. Never use NEXT_PUBLIC_ or commit a populated file.
OPENAI_API_KEY=
# Text model only; must support Responses API strict JSON Schema. Do not put a Realtime model here.
OPENAI_MODEL=gpt-4.1-mini
# Postmark inbound HTTP Basic Auth secret, available directly to the application.
POSTMARK_INBOUND_SECRET=
# Postmark outbound API token (can use an HTTPS proxy secret for api.postmarkapp.com).
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=
# Address customers actually send to (Postmark inbound address or a forwarding alias).
POSTMARK_INBOUND_EMAIL=
